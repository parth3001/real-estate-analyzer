# Server configuration
PORT=3001
NODE_ENV=development

# CORS configuration
CORS_ORIGIN=http://localhost:3000

# OpenAI API configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo

# Census API configuration
CENSUS_API_KEY=your_census_api_key_here

# RentCast API configuration
RENTCAST_API_KEY=your_rentcast_api_key_here
RENTCAST_BASE_URL=https://api.rentcast.io/v1

# RentCast API Cache Configuration (in hours)
# Real estate market data changes infrequently, 120 days cache for optimal performance  
RENTCAST_CACHE_TTL_HOURS=2880

# MongoDB configuration
MONGODB_URI=mongodb://localhost:27017/real-estate-analyzer
# For MongoDB Atlas, use something like:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/real-estate-analyzer?retryWrites=true&w=majority

# Logging
LOG_DIR=./logs
LOG_LEVEL=info 