{
  "name": "reanalyzr-backend",
  "version": "1.0.0",
  "description": "Backend for reanalyzr Platform",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json --skipLibCheck",
    "postinstall": "npm run build",
    "reset-admin": "ts-node src/scripts/resetAdminPassword.ts",
    "test": "jest",
    "validate-docs": "npx ts-node scripts/validate-docs.ts",
    "test:docs": "jest tests/integration/documentation-consistency.test.ts",
    "test:integration": "jest --testPathPattern=integration",
    "test:financial": "jest --testPathPattern=financial-accuracy",
    "test:portfolio": "jest --testPathPattern=portfolio",
    "test:benchmarks": "jest --testPathPattern=calculation-benchmarks",
    "test:quick": "jest --onlyChanged --silent",
    "test:display-bugs": "jest --testPathPattern=display-accuracy",
    "test:backend": "npm run test:integration",
    "analyze:platform": "node professional-investment-analyst.js",
    "test:e2e": "node scripts/test-orchestrator.js",
    "test:e2e:headless": "cypress run",
    "test:e2e:open": "cypress open",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "test:frontend": "cd ../frontend && npm test -- --watchAll=false",
    "test:ai-content": "node test-ai-content-validation.js",
    "test:pre-commit": "npm run test:financial && npm run test:portfolio && npm run test:display-bugs && npm run test:quick",
    "test:full-validation": "npm run test:coverage && npm run test:benchmarks && npm run test:ai-content && npm run test:e2e",
    "test:coverage": "jest --coverage",
    "collect-assessment-ratios": "npx ts-node src/scripts/collectAssessmentRatios.ts",
    "validate-tax-data": "npx ts-node src/scripts/validateTaxData.ts",
    "load-all-states-data": "npx ts-node src/scripts/loadAllStatesData.ts"
  },
  "keywords": [
    "real-estate",
    "analysis",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.1.3",
    "@types/supertest": "^6.0.3",
    "@types/winston": "^2.4.4",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "financial": "^0.2.4",
    "formulajs": "^1.0.8",
    "helmet": "^8.1.0",
    "jest": "^29.7.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.4.3",
    "mongodb": "^6.17.0",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.0",
    "mortgage-calculator": "^1.1.2",
    "openai": "^5.8.2",
    "resend": "^6.1.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cypress/react": "^9.0.1",
    "@cypress/webpack-dev-server": "^4.1.0",
    "@types/helmet": "^0.0.48",
    "@types/nock": "^10.0.3",
    "cypress": "^14.5.2",
    "mongodb-memory-server": "^9.1.3",
    "nock": "^13.5.6",
    "nodemon": "^2.0.22",
    "wait-on": "^8.0.4"
  }
}
