# ============================================================
# REanalyzr Frontend — Environment Variables (build-time)
# ============================================================
# Vite reads these from import.meta.env. Production values are
# set in the Render dashboard. Locally, copy this file to .env
# (gitignored) and fill in any values you actually need.
# ============================================================

# Microsoft Clarity project ID
# - Get from clarity.microsoft.com (Settings -> Setup)
# - When set, Vite injects the Clarity tracking snippet into index.html at build time
# - Leave blank or unset locally to skip tracking in development
# - Production project ID: wi8te8zn65
VITE_CLARITY_PROJECT_ID=

# Backend API base URL — MUST INCLUDE the /api suffix.
# - It is used directly as the axios baseURL in src/services/api.ts, and
#   every caller passes bare paths ('/deals', '/pipeline/deals', ...).
#   Omitting /api here 404s every request in production.
# - Production: https://real-estate-analyzer-api.onrender.com/api
# - Local: leave unset (falls back to '/api' via the Vite proxy)
VITE_API_URL=

# Stripe Payment Link URL for $4.99 Deal Analysis Unlock (Task #34)
# - Get from Stripe Dashboard -> Payment Links -> (your link) -> URL
# - Test mode:  https://buy.stripe.com/test_xxxxxxxxxx
# - Live mode:  https://buy.stripe.com/xxxxxxxxxx (swap on launch day)
# - Leave blank locally to render the PaywallCTA with a disabled
#   "Payment integration launching soon" button (no redirect wired)
# - FREE BETA (2026-08-30): deliberately left UNSET in production too.
#   The backend runs with BILLING_ENABLED=false, which grants every
#   analyzed property a free license, so the paywall never renders and
#   this link is unreachable. Set it when billing goes live.
VITE_STRIPE_PAYMENT_LINK=
