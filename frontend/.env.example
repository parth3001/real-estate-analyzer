# ============================================================
# REanalyzr Frontend — Environment Variables (build-time)
# ============================================================
# Vite reads these from import.meta.env. Production values are
# set in the Render dashboard. Locally, copy this file to .env
# (gitignored) and fill in any values you actually need.
# ============================================================

# Microsoft Clarity project ID
# - Get from clarity.microsoft.com (Settings -> Setup)
# - When set, Vite injects the Clarity tracking snippet into index.html at build time
# - Leave blank or unset locally to skip tracking in development
# - Production project ID: wi8te8zn65
VITE_CLARITY_PROJECT_ID=

# Backend API base URL (no trailing /api)
# - Production: https://real-estate-analyzer-api.onrender.com
# - Local: leave unset (defaults to http://localhost:3001 via Vite proxy)
VITE_API_URL=
